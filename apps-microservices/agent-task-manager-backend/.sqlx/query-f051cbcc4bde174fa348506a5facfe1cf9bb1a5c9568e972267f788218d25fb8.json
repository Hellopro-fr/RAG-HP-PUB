  "query": "SELECT l.from_id, l.to_id, l.kind FROM task_links l JOIN tasks t ON t.id = l.to_id\n           WHERE ($1::uuid IS NULL OR t.project_id = $1)\n             AND ($2::uuid IS NULL OR l.from_id = $2 OR l.to_id = $2)\n           ORDER BY l.created_at",
